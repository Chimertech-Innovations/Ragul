# ==========================================
# RAGUL AI - Environment Configuration
# ==========================================

# LLM Provider Configuration
# Provider: "jarvislabs"
LLM_PROVIDER=jarvislabs
JARVISLABS_API_KEY=your_jarvislabs_api_key_here
LLM_API_BASE=https://models.jarvislabs.net/v1
LLM_MODEL_NAME=glm-5.3-flash
LLM_TEMPERATURE=0.2


# Memory Optimization for Cloud Hosting (512MB RAM free tier)
DISABLE_RERANKER=true
WEB_CONCURRENCY=1

# Audio Speech-to-Text (Groq Cloud Whisper API for <2s response, faster-whisper local fallback)
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Voice Activity Detection (Silero VAD)
VAD_SAMPLE_RATE=16000
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION_MS=250
VAD_MIN_SILENCE_DURATION_MS=700

# Text-to-Speech Engine
TTS_ENGINE=gtts
DEFAULT_LANGUAGE=ta

# ==========================================
# Supabase Cloud Database Integration
# ==========================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your-project-id.supabase.co:5432/postgres


